<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ feature.name }} — 互動原型</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "PingFang TC", "Microsoft JhengHei", sans-serif;
    background: #0a0a14;
    color: #fff;
    min-height: 100vh;
    overflow-x: hidden;
    padding: 20px;
  }
  /* 固定 layout skeleton — AI 只填內容不刻骨架 */
  .proto-page { max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
  .proto-tabs { display: flex; gap: 8px; justify-content: center; }
  .proto-tab  { padding: 10px 20px; background: #1a1a2e; color: #fff; border: 1px solid #ffd700;
                border-radius: 8px; cursor: pointer; font-size: 14px; font-family: inherit; }
  .proto-tab.on { background: #ffd700; color: #1a1a2e; font-weight: 700; }
  .proto-surface { display: none; min-height: 600px; }
  .proto-surface.on { display: block; }
  .proto-help { position: fixed; top: 16px; left: 16px; background: #fff; color: #000;
                padding: 12px 16px; border-radius: 8px; font-size: 13px; max-width: 280px;
                box-shadow: 0 4px 16px rgba(0,0,0,.3); z-index: 50; }
  .proto-help ol { padding-left: 20px; margin: 8px 0; }
  .proto-help li { margin: 4px 0; line-height: 1.4; }
  .proto-help button { margin-top: 8px; padding: 6px 14px; background: #1a1a2e; color: #fff;
                       border: none; border-radius: 4px; cursor: pointer; font-family: inherit; }
</style>
</head>
<body>
{{ prototype_html | safe }}
</body>
</html>
