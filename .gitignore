# User-generated output — produced by genecr in the user's CWD, must never be in the repo
output/

# Project-level Claude Code config (not part of genecr distribution)
.claude/

# Local-only files
.source-dir
*.pdf
references/*
!references/.gitkeep
preview.html
pdd *.md
skills-lock.json

# tools/bin/ contents are produced by tools/<pkg>/setup.sh — never commit
tools/bin/*
!tools/bin/.gitkeep
!tools/bin/genecr-env.sh
!tools/bin/genecr-env.ps1

# Python bytecode
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
