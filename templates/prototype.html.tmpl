<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=375, initial-scale=1, maximum-scale=1">
<title>{{ feature.name }} — 互動原型</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "PingFang TC", "Microsoft JhengHei", sans-serif;
    background: #0a0a14;
    color: #fff;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
  }
  .phone {
    width: 375px;
    min-height: 100vh;
    background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1e 100%);
    position: relative;
    box-shadow: 0 0 60px rgba(255,215,0,0.15);
  }
  .header {
    padding: 16px;
    background: linear-gradient(90deg, #2a1a4e, #1a1a2e);
    border-bottom: 2px solid #ffd700;
    text-align: center;
  }
  .header h1 { color: #ffd700; font-size: 20px; }

  /* Tab axes */
  .tab-bar { display: flex; background: #1a1a2e; border-bottom: 1px solid #333; }
  .tab-bar button {
    flex: 1; padding: 12px; border: none; background: transparent;
    color: #888; font-size: 14px; cursor: pointer; transition: 0.2s;
  }
  .tab-bar button.active {
    color: #ffd700;
    border-bottom: 2px solid #ffd700;
    background: rgba(255,215,0,0.05);
  }

  /* List */
  .list { padding: 8px; min-height: 60vh; }
  .row {
    display: flex; align-items: center; padding: 10px 12px; margin-bottom: 6px;
    background: rgba(255,255,255,0.04); border-radius: 8px;
    transition: transform 0.4s, background 0.4s;
  }
  .row.top1 { background: linear-gradient(90deg, rgba(255,215,0,0.25), transparent); border-left: 3px solid #ffd700; }
  .row.top2 { background: linear-gradient(90deg, rgba(192,192,192,0.2), transparent); border-left: 3px solid #c0c0c0; }
  .row.top3 { background: linear-gradient(90deg, rgba(205,127,50,0.2), transparent); border-left: 3px solid #cd7f32; }
  .row.up { animation: flashUp 0.6s ease; }
  .row.down { animation: flashDown 0.6s ease; }
  @keyframes flashUp { 0%,100% {} 50% { background: rgba(0,255,127,0.3); } }
  @keyframes flashDown { 0%,100% {} 50% { background: rgba(255,107,53,0.3); } }

  .rank { width: 36px; font-weight: bold; text-align: center; color: #ffd700; font-size: 16px; }
  .name { flex: 1; padding: 0 10px; font-size: 14px; }
  .score { color: #ff6b35; font-weight: bold; font-size: 14px; }

  /* My rank bar */
  .myrank {
    position: sticky; bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(90deg, #ffd700, #ff6b35);
    color: #1a1a2e; font-weight: bold;
    display: flex; justify-content: space-between; align-items: center;
  }

  /* Help panel */
  .help {
    position: fixed; top: 12px; left: 12px;
    width: 220px; background: rgba(20,20,40,0.95);
    border: 1px solid #ffd700; border-radius: 8px;
    padding: 12px; font-size: 12px; color: #ddd;
    z-index: 100; line-height: 1.6;
  }
  .help h3 { color: #ffd700; margin-bottom: 6px; font-size: 13px; }
  .help button {
    margin-top: 8px; padding: 4px 8px; font-size: 11px;
    background: #ffd700; color: #1a1a2e; border: none; border-radius: 4px; cursor: pointer;
  }

  /* Reward popup */
  .popup-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.7);
    display: none; justify-content: center; align-items: center; z-index: 200;
  }
  .popup-overlay.show { display: flex; }
  .popup {
    background: linear-gradient(135deg, #2a1a4e, #1a1a2e);
    border: 2px solid #ffd700; border-radius: 16px;
    padding: 30px; text-align: center; max-width: 280px;
    animation: pop 0.4s ease;
    box-shadow: 0 0 60px rgba(255,215,0,0.5);
  }
  @keyframes pop { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .popup h2 { color: #ffd700; font-size: 24px; margin-bottom: 12px; }
  .popup .reward { font-size: 32px; color: #ff6b35; font-weight: bold; margin: 16px 0; }
  .popup button {
    padding: 10px 24px; background: #ffd700; color: #1a1a2e;
    border: none; border-radius: 20px; font-weight: bold; cursor: pointer;
  }

  /* Coin particles */
  .particle {
    position: fixed; width: 12px; height: 12px;
    background: radial-gradient(circle, #ffd700, #ff6b35);
    border-radius: 50%; pointer-events: none; z-index: 199;
  }
</style>
</head>
<body>

<div class="help">
  <h3>📖 操作說明</h3>
  <div id="step-text">{{ help_steps[0] }}</div>
  <button onclick="nextStep()">下一步</button>
</div>

<div class="phone">
  <div class="header">
    <h1>🏆 {{ feature.name }}</h1>
  </div>

  <!-- Axis 1 -->
  <div class="tab-bar" id="axis1">
    {% for opt in axes[0].options %}
    <button data-key="{{ opt.key }}"{% if loop.first %} class="active"{% endif %}>{{ opt.label }}</button>
    {% endfor %}
  </div>

  <!-- Axis 2 -->
  <div class="tab-bar" id="axis2">
    {% for opt in axes[1].options %}
    <button data-key="{{ opt.key }}"{% if loop.first %} class="active"{% endif %}>{{ opt.label }}</button>
    {% endfor %}
  </div>

  <!-- Axis 3 -->
  <div class="tab-bar" id="axis3">
    {% for opt in axes[2].options %}
    <button data-key="{{ opt.key }}"{% if loop.first %} class="active"{% endif %}>{{ opt.label }}</button>
    {% endfor %}
  </div>

  <div class="list" id="list"></div>

  <div class="myrank">
    <span>{{ my_rank.label }}</span>
    <span id="myRank">{{ my_rank.default }}</span>
  </div>
</div>

<div class="popup-overlay" id="popup">
  <div class="popup">
    <h2>🎉 領獎成功</h2>
    <div class="reward" id="rewardAmt">+0</div>
    <p style="color:#aaa">獎勵已加入錢包</p>
    <button onclick="closePopup()">太棒了</button>
  </div>
</div>

<script>
const DATA = {{ mock_data | tojson }};
const HELP_STEPS = {{ help_steps | tojson }};
let currentAxis = ['{{ axes[0].options[0].key }}', '{{ axes[1].options[0].key }}', '{{ axes[2].options[0].key }}'];
let stepIdx = 0;

function getKey() { return currentAxis.join('|'); }

function render(animate) {
  const key = getKey();
  const rows = DATA[key] || DATA[Object.keys(DATA)[0]];
  const list = document.getElementById('list');
  list.innerHTML = '';
  rows.forEach((r, i) => {
    const div = document.createElement('div');
    div.className = 'row' + (i===0?' top1':i===1?' top2':i===2?' top3':'');
    if (animate) div.classList.add(Math.random() > 0.5 ? 'up' : 'down');
    div.innerHTML = `<div class="rank">${i+1}</div><div class="name">${r.name}</div><div class="score">${r.score.toLocaleString()}</div>`;
    list.appendChild(div);
  });
}

document.querySelectorAll('.tab-bar').forEach((bar, idx) => {
  bar.addEventListener('click', e => {
    if (e.target.tagName !== 'BUTTON') return;
    bar.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    currentAxis[idx] = e.target.dataset.key;
    render(true);
  });
});

function nextStep() {
  stepIdx = (stepIdx + 1) % HELP_STEPS.length;
  document.getElementById('step-text').textContent = HELP_STEPS[stepIdx];
  if (stepIdx === HELP_STEPS.length - 1) showReward();
}

function showReward() {
  document.getElementById('rewardAmt').textContent = '+{{ reward.amount }}';
  document.getElementById('popup').classList.add('show');
  spawnCoins();
}
function closePopup() { document.getElementById('popup').classList.remove('show'); }
function spawnCoins() {
  for (let i = 0; i < 30; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    p.style.left = (window.innerWidth/2) + 'px';
    p.style.top = (window.innerHeight/2) + 'px';
    document.body.appendChild(p);
    const ang = Math.random() * Math.PI * 2;
    const dist = 100 + Math.random() * 200;
    p.animate([
      { transform: 'translate(0,0) scale(1)', opacity: 1 },
      { transform: `translate(${Math.cos(ang)*dist}px, ${Math.sin(ang)*dist}px) scale(0.3)`, opacity: 0 }
    ], { duration: 800 + Math.random()*400, easing: 'cubic-bezier(.2,.8,.4,1)' });
    setTimeout(() => p.remove(), 1300);
  }
}

render(false);
</script>
</body>
</html>
