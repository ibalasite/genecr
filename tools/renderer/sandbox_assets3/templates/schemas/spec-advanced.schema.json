{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec-advanced input",
  "type": "object",
  "required": ["feature", "architecture", "client", "apis", "data_models", "business_logic", "cache_strategy"],
  "properties": {
    "feature": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string"}
      }
    },
    "architecture": {
      "type": "object",
      "required": ["overview", "diagram"],
      "properties": {
        "overview": {"type": "string"},
        "diagram": {
          "type": "string",
          "description": "Mermaid diagram source (flowchart/erDiagram/sequenceDiagram). MUST stay non-empty — preserved render feature."
        },
        "data_flow": {"type": "string"}
      }
    },
    "client": {
      "type": "object",
      "required": ["scene", "components", "states"],
      "properties": {
        "scene": {"type": "string"},
        "components": {"type": "array"},
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "trigger", "to"],
            "properties": {
              "from": {"type": "string"},
              "trigger": {"type": "string"},
              "to": {"type": "string"}
            }
          }
        },
        "update_strategy": {"type": "string"},
        "performance": {"type": "string"}
      }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "summary", "description", "auth", "parameters", "responses"],
        "properties": {
          "id": {"type": "string"},
          "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "path": {"type": "string"},
          "summary": {"type": "string", "description": "one-line title for listings"},
          "description": {"type": "string", "description": "long-form description"},
          "auth": {
            "type": "object",
            "required": ["required", "type"],
            "properties": {
              "required": {"type": "boolean"},
              "type": {"type": "string", "enum": ["none", "bearer", "api_key", "cookie", "basic"]},
              "location": {"type": "string", "enum": ["header", "cookie", "query"], "description": "for api_key/cookie: where the credential travels"},
              "name": {"type": "string", "description": "header/cookie/query param name (e.g. Authorization / X-API-Key)"},
              "format": {"type": "string", "description": "value format hint (e.g. 'Bearer {token}')"},
              "scopes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["in", "name", "type", "required"],
              "properties": {
                "in": {"type": "string", "enum": ["path", "query", "header"]},
                "name": {"type": "string"},
                "type": {"type": "string"},
                "required": {"type": "boolean"},
                "description": {"type": "string"},
                "example": {},
                "default": {},
                "enum": {"type": "array"},
                "pattern": {"type": "string"},
                "minimum": {"type": "number"},
                "maximum": {"type": "number"}
              }
            }
          },
          "request_body": {
            "type": "object",
            "required": ["required", "content_type", "schema", "example"],
            "properties": {
              "required": {"type": "boolean"},
              "content_type": {"type": "string", "enum": ["application/json", "application/x-www-form-urlencoded", "multipart/form-data"]},
              "schema": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {"type": "string"},
                  "properties": {"type": "object"},
                  "required": {"type": "array", "items": {"type": "string"}}
                }
              },
              "example": {}
            }
          },
          "responses": {
            "type": "object",
            "minProperties": 2,
            "patternProperties": {
              "^[1-5][0-9][0-9]$": {
                "type": "object",
                "required": ["description", "schema", "example"],
                "properties": {
                  "description": {"type": "string"},
                  "schema": {"type": "object"},
                  "example": {},
                  "headers": {"type": "object"}
                }
              }
            },
            "additionalProperties": false
          },
          "rate_limit": {
            "type": "object",
            "properties": {
              "per_minute": {"type": "integer"},
              "per_user": {"type": "boolean"}
            }
          },
          "idempotency": {
            "type": "object",
            "properties": {
              "required": {"type": "boolean"},
              "header": {"type": "string"}
            }
          },
          "deprecated": {"type": "boolean"},
          "version_added": {"type": "string"},
          "reads": {},
          "writes": {},
          "flow": {"type": "array", "items": {"type": "string"}},
          "perf": {"type": "string"},
          "related_bdd": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "data_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"type": "string", "description": "e.g. mysql / postgres / sqlite / 'MySQL Table' / redis"},
          "desc": {"type": "string"},
          "fields": {"type": "array"},
          "indexes": {"description": "array of index definitions, or placeholder string in template examples"},
          "apis": {"type": "array"},
          "create_table_sql": {
            "type": "string",
            "description": "Full CREATE TABLE SQL (for relational kind) — used for downstream cross-check"
          },
          "redis_pattern": {
            "type": "string",
            "description": "Key pattern (for redis kind) e.g. user:{uid}:level"
          },
          "value_type": {
            "type": "string",
            "description": "redis value type: string/hash/list/zset/set"
          },
          "ttl": {"description": "seconds or 'permanent'"}
        },
        "allOf": [
          {
            "comment": "Conditional required fields by kind. Relational entries need fields[]; redis entries need redis_pattern + value_type. Avoids the convergence bug where AI sensibly omits fields for a redis string key but schema demanded fields unconditionally.",
            "if": { "properties": { "kind": { "const": "redis" } } },
            "then": { "required": ["redis_pattern", "value_type"] },
            "else": { "required": ["fields"] }
          }
        ]
      }
    },
    "business_logic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "desc"],
        "properties": {
          "title": {"type": "string"},
          "desc": {"type": "string"},
          "pseudocode": {"type": "string"}
        }
      }
    },
    "cache_strategy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "desc"],
        "properties": {
          "key": {"type": "string"},
          "ttl": {},
          "desc": {"type": "string"}
        }
      }
    },
    "db_queries": {
      "type": "array",
      "description": "Scenario SQL with index alignment metadata for cross_check",
      "items": {
        "type": "object",
        "required": ["scenario", "sql"],
        "properties": {
          "scenario": {"type": "string"},
          "sql": {"type": "string"},
          "used_indexes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "redis_ops": {
      "type": "array",
      "description": "Scenario Redis operations with key alignment metadata for cross_check",
      "items": {
        "type": "object",
        "required": ["scenario", "commands"],
        "properties": {
          "scenario": {"type": "string"},
          "commands": {"type": "array", "items": {"type": "string"}},
          "accessed_keys": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "counts": {
      "type": "object",
      "description": "Derived counts for downstream cross_check (api_endpoints, tables, redis_keys)",
      "properties": {
        "api_endpoints": {"type": "integer", "minimum": 0},
        "tables": {"type": "integer", "minimum": 0},
        "redis_keys": {"type": "integer", "minimum": 0}
      }
    }
  }
}
