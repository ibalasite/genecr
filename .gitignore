# User-generated output — produced by genecr in the user's CWD, must never be in the repo
output/

# All dotfiles/dotdirs — never push local state (.claude/, .gendoc-state.json, etc.)
.*
!.gitignore
!.gitkeep

# Local-only files
*.pdf
references/*
!references/.gitkeep
preview.html
pdd *.md
skills-lock.json

# Python bytecode
__pycache__/
*.pyc

# OS / editor noise
Thumbs.db
*.swp
