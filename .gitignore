# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# Local state files (mirror gendoc convention — name them, don't blanket .*)
.gendoc-state*.json
.skill-guard.json
.skill-guard-queue
.last-update-check
.update-lock/
.claude/
.gstack/
.source-dir
skills-lock.json

# User-generated output — produced in user's CWD, never in repo
output/

# Local-only / draft artifacts
*.pdf
references/*
!references/.gitkeep
preview.html
pdd *.md

# Python bytecode
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
