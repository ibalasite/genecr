# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# Local state files (mirror gendoc convention — name them, don't blanket .*)
.gendoc-state*.json
.skill-guard.json
.skill-guard-queue
.last-update-check
.update-lock/
.claude/
.gstack/
.source-dir
skills-lock.json

# User-generated output — produced in user's CWD, never in repo
output/

# Local-only / draft artifacts
*.pdf
references/*
!references/.gitkeep
preview.html
pdd *.md

# Python bytecode
__pycache__/
*.pyc

# tools/bin/ 內由 tools/renderer/build.sh glob-copy 產生的 .py — SSOT 在 tools/renderer/
# 只排除 renderer package 的產出，非 build.sh package 的單檔 py 仍應進 git
tools/bin/cross_check.py
tools/bin/inverse.py
tools/bin/orchestrate.py
tools/bin/pipeline.py
tools/bin/pipeline_orchestrated.py
tools/bin/render.py
tools/bin/review_loop.py
tools/bin/sandbox_assets_parallel.py
tools/bin/sandbox_truncation.py

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# PyInstaller build artifacts
gui/dist/
gui/build/
gui/genecr-gui.spec
gui/__pycache__/

# Inno Setup build artifacts
installer/dist/

# Local debug screenshots (Playwright audit)
screenshots/
