{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scrum input",
  "type": "object",
  "required": ["feature", "epic", "groups", "stories"],
  "properties": {
    "feature": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string"}
      }
    },
    "epic": {
      "type": "object",
      "required": ["title", "desc"],
      "properties": {
        "title": {"type": "string"},
        "desc": {"type": "string"}
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": {"type": "string"},
          "name": {"type": "string"},
          "icon": {"type": "string"}
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "title", "role", "want", "benefit", "owner_role", "points"],
        "properties": {
          "id": {"type": ["string", "integer"]},
          "group": {"type": "string"},
          "title": {"type": "string"},
          "role": {"type": "string", "description": "User story 中的 'as a ...' 角色（玩家/管理員/...），不是 owner"},
          "want": {"type": "string"},
          "benefit": {"type": "string"},
          "acceptance": {"type": "array"},
          "owner_role": {
            "type": "string",
            "enum": ["server_engineer", "client_engineer", "planner", "po", "art"],
            "description": "scrum team 中誰負責這個 story（個人 role，不是 team / 組）"
          },
          "points": {
            "type": "integer",
            "enum": [1, 2, 3, 5, 8, 13],
            "description": "Fibonacci. 1 點 = 1 工作天。預設 1-3 點；5 = 較大但單 sprint 可完；8/13 = 真 epic 應拆"
          },
          "depends_on": {"type": "array"}
        }
      }
    }
  }
}
