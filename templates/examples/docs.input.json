  "api_explorer": [
    {
      "id": "api-get-leaderboard",
      "method": "GET",
      "path": "/api/v1/leaderboard",
      "desc": "取得排行榜資料",
      "params": [
        {"name": "category", "in": "query", "type": "string", "default": "personal"},
        {"name": "metric", "in": "query", "type": "string", "default": "bet"},
        {"name": "period", "in": "query", "type": "string", "default": "7d"},
        {"name": "limit", "in": "query", "type": "integer", "default": "100"}
      ],
      "responses": {
        "200": {
          "status": 200,
          "body": {"code": 200, "data": {"list": [{"rank": 1, "name": "Lucky888", "score": 9876543}], "my": {"rank": 152, "score": 12345}}}
        }
      }
    },
    {
      "id": "api-claim-reward",
      "method": "POST",
      "path": "/api/v1/leaderboard/claim",
      "desc": "領取週期結算獎勵",
      "body": {
        "presets": [
          {"label": "Default - 正常領獎", "value": "{\n  \"period_id\": \"2026W19\",\n  \"category\": \"personal\",\n  \"metric\": \"bet\"\n}"},
          {"label": "409 - 已領過", "value": "{\n  \"period_id\": \"2026W18\",\n  \"category\": \"personal\",\n  \"metric\": \"bet\"\n}"}
        ]
      },
      "responses": {
        "200": {"status": 200, "body": {"code": 200, "data": {"reward_coins": 100000, "reward_diamonds": 50}}}
      }
    }
  ],
  "prototype_path": "leaderboard-prototype.html"
}
