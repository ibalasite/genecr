{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec-basic input",
  "type": "object",
  "required": ["feature", "change_log", "related_docs", "summary", "competitors", "axes", "matrix", "fields", "rules", "user_journey", "ui_sections", "ui_misc", "i18n", "help_page", "timeline", "resources", "resource_counts", "dryrun"],
  "properties": {
    "feature": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string", "minLength": 5},
        "slug": {"type": "string", "minLength": 5}
      }
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "author", "note"],
        "properties": {"date": {"type": "string"}, "author": {"type": "string"}, "note": {"type": "string"}}
      }
    },
    "related_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "desc", "status"],
        "properties": {"file": {"type": "string"}, "desc": {"type": "string"}, "status": {"type": "string"}}
      }
    },
    "summary": {
      "type": "object",
      "required": ["what", "why", "audience"],
      "properties": {"what": {"type": "string"}, "why": {"type": "string"}, "audience": {"type": "string"}}
    },
    "competitors": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "market", "highlight", "url"],
        "properties": {
          "name":            {"type": "string"},
          "market":          {"type": "string"},
          "highlight":       {"type": "string"},
          "url":             {"type": "string"},
          "mechanic":        {"type": "string", "description": "核心機制細節"},
          "rtp":             {"type": "string", "description": "RTP / 倍率區間 / 中獎機率"},
          "payout":          {"type": "string", "description": "獎勵結構（最高倍、保底、特殊獎）"},
          "user_flow":       {"type": "string", "description": "玩家從入口到領獎的步驟"},
          "differentiation": {"type": "string", "description": "差異化亮點"},
          "weakness":        {"type": "string", "description": "缺點 / 可改進處"}
        }
      }
    },
    "comparison_table": {
      "type": "object",
      "properties": {
        "competitors": {"type": "array", "items": {"type": "string"}},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "us", "others"],
            "properties": {"item": {"type": "string"}, "us": {"type": "string"}, "others": {"type": "array", "items": {"type": "string"}}}
          }
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "options"],
        "properties": {
          "name": {"type": "string"},
          "options": {"type": "array", "items": {"type": "object", "required": ["name", "desc"], "properties": {"name": {"type": "string"}, "desc": {"type": "string"}}}}
        }
      }
    },
    "matrix": {
      "type": "object",
      "required": ["description", "row_axis", "col_axis", "cols", "rows"],
      "properties": {
        "description": {"type": "string"},
        "row_axis": {"type": "string"},
        "col_axis": {"type": "string"},
        "cols": {"type": "array", "items": {"type": "string"}},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "cells", "time"],
            "properties": {"label": {"type": "string"}, "cells": {"type": "array", "items": {"type": "string"}}, "time": {"type": "string"}}
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "desc"],
        "properties": {"name": {"type": "string"}, "desc": {"type": "string"}, "example": {"type": "string"}}
      }
    },
    "rules": {
      "type": "object",
      "required": ["trigger", "data", "sorting", "anti_cheat"],
      "properties": {"trigger": {"type": "string"}, "data": {"type": "string"}, "sorting": {"type": "string"}, "anti_cheat": {"type": "string"}}
    },
    "user_journey": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "detail", "emotion"],
        "properties": {"action": {"type": "string"}, "detail": {"type": "string"}, "emotion": {"type": "string"}}
      }
    },
    "admin_journey": {
      "type": "array",
      "description": "管理員旅程；有 admin wireframe 時必填，每一步對應一個後台操作（建立活動 / 補簽 / 匯出 / 報表 等）",
      "items": {
        "type": "object",
        "required": ["action", "detail"],
        "properties": {
          "action": {"type": "string"},
          "detail": {"type": "string"},
          "role": {"type": "string", "description": "操作者角色（例 admin / GM / customer_service）"}
        }
      }
    },
    "ui_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "detail"],
        "properties": {"name": {"type": "string"}, "detail": {"type": "string"}}
      }
    },
    "ui_misc": {
      "type": "object",
      "required": ["refresh", "extensibility", "edge_cases"],
      "properties": {"refresh": {"type": "string"}, "extensibility": {"type": "string"}, "edge_cases": {"type": "string"}}
    },
    "i18n": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zh", "en", "es"],
        "properties": {"zh": {"type": "string"}, "en": {"type": "string"}, "es": {"type": "string"}}
      }
    },
    "help_page": {
      "type": "object",
      "required": ["hook", "bullets", "steps"],
      "properties": {
        "hook": {"type": "string"},
        "bullets": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "content", "duration", "duration_weeks"],
        "properties": {
          "phase": {"type": "string"},
          "content": {"type": "string"},
          "duration": {"type": "string", "description": "Human-readable, e.g. '2 週'"},
          "duration_weeks": {"type": "integer", "minimum": 1, "description": "Numeric weeks for cross_check with scrum points"}
        }
      }
    },
    "resource_counts": {
      "type": "object",
      "description": "資源（UI 素材檔）+ bookkeeping count。Top-level keys 限定 enum：6 種素材（nested {子類: N}）或 bookkeeping（整數）。文案/i18n 等屬 spec-basic.i18n，不在這。",
      "required": ["visual_total", "audio_total"],
      "properties": {
        "image":     {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "minProperties": 1},
        "animation": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "minProperties": 1},
        "sound":     {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "minProperties": 1},
        "video":     {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "minProperties": 1},
        "font":      {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "minProperties": 1},
        "particle":  {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "minProperties": 1},
        "modules":             {"type": "integer", "minimum": 0},
        "acceptance_criteria": {"type": "integer", "minimum": 0},
        "api_endpoints":       {"type": "integer", "minimum": 0},
        "visual_total": {"type": "integer", "minimum": 0, "description": "image+animation+particle+video+font 實體總數（AI 自報，作為 §14 與 assets 對齊合約）"},
        "audio_total":  {"type": "integer", "minimum": 0, "description": "sound 實體總數"}
      },
      "additionalProperties": false
    },
    "dryrun": {
      "type": "object",
      "description": "basic 根據 wireframe/UI 需求預估下游技術規模，供 timeline 公式使用，不依賴下游 step。",
      "properties": {
        "tech_counts": {
          "type": "object",
          "required": ["api_endpoints", "db_tables", "redis_keys"],
          "properties": {
            "api_endpoints": {"type": "integer", "minimum": 0, "description": "從 wireframe 操作需求估出的 API 數"},
            "db_tables":     {"type": "integer", "minimum": 0, "description": "這些 API 需要幾張 DB table"},
            "redis_keys":    {"type": "integer", "minimum": 0, "description": "有幾個 Redis key pattern（無需求填 0）"}
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["art", "audio", "engineering"],
      "properties": {"art": {"type": "string"}, "audio": {"type": "string"}, "engineering": {"type": "string"}}
    },
    "wireframes": {
      "type": "array",
      "description": "Low-fidelity wireframes using the wf-* CSS DSL. Required for major UI screens.",
      "items": {
        "type": "object",
        "required": ["name", "desc", "html"],
        "properties": {
          "name": {"type": "string", "description": "screen name, e.g. '主畫面' or '領獎彈窗'"},
          "desc": {"type": "string", "description": "1-2 sentences explaining what this screen shows"},
          "html": {"type": "string", "description": "HTML snippet using only wf-* classes from wireframe-dsl.md, wrapped in <div class=\"wf-scope\">…</div>"}
        }
      }
    }
  }
}
