# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# Local state files (mirror gendoc convention — name them, don't blanket .*)
.gendoc-state*.json
.skill-guard.json
.skill-guard-queue
.last-update-check
.update-lock/
.claude/
.gstack/
.source-dir
skills-lock.json

# User-generated output — produced in user's CWD, never in repo
output/

# Local-only / draft artifacts
*.pdf
references/*
!references/.gitkeep
preview.html
pdd *.md

# Python bytecode
__pycache__/
*.pyc

# tools/bin/*.py — build 產物，由 tools/renderer/build.sh 複製，SSOT 在 tools/renderer/
tools/bin/*.py

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# PyInstaller build artifacts
gui/dist/
gui/build/
gui/genecr-gui.spec
gui/__pycache__/

# Inno Setup build artifacts
installer/dist/

# Local debug screenshots (Playwright audit)
screenshots/
