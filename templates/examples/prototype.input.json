  "prototype_html": "<div class=\"proto-page\">\n  <div class=\"proto-tabs\">\n    <button class=\"proto-tab on\" data-surface=\"player\">玩家端</button>\n    <button class=\"proto-tab\" data-surface=\"admin\">管理後台</button>\n  </div>\n  <div class=\"proto-surface on\" data-surface=\"player\">\n    <style>.phone{width:360px;margin:20px auto;background:#1a1a2e;color:#fff;padding:16px;border-radius:24px}</style>\n    <div class=\"phone\">\n      <header>玩家畫面 — 主畫面（每個 user_journey 步驟有對應互動）</header>\n      <main>...</main>\n    </div>\n  </div>\n  <div class=\"proto-surface\" data-surface=\"admin\">\n    <style>.desktop{width:1100px;max-width:100%;margin:20px auto;background:#fff;color:#000;padding:24px;border-radius:8px}</style>\n    <div class=\"desktop\">\n      <header>後台 — 玩家記錄列表 (admin)</header>\n      <table><thead><tr><th>玩家</th><th>當前天數</th><th>狀態</th><th>操作</th></tr></thead>\n      <tbody><tr><td>player_001</td><td>3</td><td>active</td><td>補簽</td></tr></tbody></table>\n    </div>\n  </div>\n  <div class=\"proto-help\">\n    <h3>📖 操作說明</h3>\n    <ol>\n      <li>玩家旅程 step 1（對應 user_journey[0]）</li>\n      <li>玩家旅程 step 2（對應 user_journey[1]）</li>\n      <li>...（每個 user_journey 一條）</li>\n      <li>切到管理後台 tab</li>\n      <li>admin 操作 step 1（對應 admin_journey[0]）</li>\n      <li>...（每個 admin_journey 一條）</li>\n    </ol>\n    <button onclick=\"nextStep()\">下一步 →</button>\n  </div>\n  <script>\n    document.querySelectorAll('.proto-tab').forEach(t => t.onclick = () => {\n      document.querySelectorAll('.proto-tab').forEach(x => x.classList.toggle('on', x===t));\n      document.querySelectorAll('.proto-surface').forEach(s => s.classList.toggle('on', s.dataset.surface===t.dataset.surface));\n    });\n    let stepIdx = 0;\n    function nextStep() { /* walk through proto-help li, trigger corresponding surface interaction */ }\n  </script>\n</div>"
}
