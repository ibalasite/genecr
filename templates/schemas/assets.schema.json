{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "assets input",
  "type": "object",
  "required": ["feature", "assets"],
  "properties": {
    "feature": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "type": {
            "type": "string",
            "description": "Asset category: image / animation / sound / video / font / particle / copywriting / i18n / ..."
          },
          "category": {
            "type": "string",
            "description": "Sub-category within type (e.g. background / character / ui under images)"
          },
          "usage": {"type": "string"},
          "spec": {},
          "image_prompt": {"type": "string"},
          "negative_prompt": {"type": "string"},
          "reference": {"description": "string URL, object with {platform, url}, or null"}
        }
      }
    }
  }
}
