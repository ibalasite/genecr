#!/usr/bin/env bash
# genecr setup — install / uninstall / upgrade, multi-host (Claude / Codex / Gemini)
#
# Usage:
#   ./setup                         # install for auto-detected host (current location)
#   ./setup install                 # same as above
#   ./setup install claude          # clone to ~/.claude/skills/genecr + deploy subskills there
#   ./setup install codex           # clone to ~/.codex/skills/genecr  + deploy subskills there
#   ./setup install gemini          # clone to ~/.gemini/skills/genecr + deploy subskills there
#   ./setup install all             # install for ALL hosts (claude + codex + gemini)
#   ./setup upgrade                 # git pull + redeploy (current host)
#   ./setup upgrade all             # upgrade ALL hosts
#   ./setup uninstall [claude|codex|gemini|all]
#
# Cross-platform: Windows (Git Bash), macOS, Linux.

set -e

REPO_URL="https://github.com/ibalasite/genecr.git"

CMD="${1:-install}"
TARGET="${2:-}"

log() { echo "$@"; }

# ── Host config ───────────────────────────────────────
_host_dir() {
  # $1 = host name → echo path
  case "$1" in
    claude) echo "$HOME/.claude/skills/genecr" ;;
    codex)  echo "$HOME/.codex/skills/genecr"  ;;
    gemini) echo "$HOME/.gemini/skills/genecr" ;;
    *)      return 1 ;;
  esac
}
_host_skills_dir() {
  case "$1" in
    claude) echo "$HOME/.claude/skills" ;;
    codex)  echo "$HOME/.codex/skills"  ;;
    gemini) echo "$HOME/.gemini/skills" ;;
    *)      return 1 ;;
  esac
}

# Detect host from this script's own location if TARGET not specified
_detect_host_from_self() {
  local self_path
  self_path="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
  case "$self_path" in
    *"/.codex/"*)  echo "codex"  ;;
    *"/.claude/"*) echo "claude" ;;
    *"/.gemini/"*) echo "gemini" ;;
    *) echo "" ;;
  esac
}

# Expand "all" → list of hosts; expand single host → that host; empty → autodetect
_resolve_targets() {
  if [[ "$1" == "all" ]]; then
    echo "claude codex gemini"
  elif [[ "$1" == "claude" || "$1" == "codex" || "$1" == "gemini" ]]; then
    echo "$1"
  elif [[ -z "$1" ]]; then
    local detected
    detected="$(_detect_host_from_self)"
    if [[ -n "$detected" ]]; then
      echo "$detected"
    else
      log "[warn] cannot autodetect host from $(_detect_host_from_self || true); defaulting to gemini"
      echo "gemini"
    fi
  else
    echo "❌ unknown target: $1 (use claude|codex|gemini|all)" >&2
    exit 1
  fi
}

# ── Subskill deployment (writes to $HOST_SKILLS_DIR) ──
_deploy_skills() {
  local runtime="$1"
  local skills_dst="$2"
  log "[deploy] $runtime/skills/* → $skills_dst/"
  mkdir -p "$skills_dst"
  if [[ ! -d "$runtime/skills" ]]; then
    log "  ⚠️  $runtime/skills 不存在，跳過"
    return
  fi
  for skill_dir in "$runtime/skills"/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    rm -rf "$skills_dst/$name"
    cp -r "$skill_dir" "$skills_dst/$name"
    log "  · $name"
  done
}

# ── python detection (gendoc pattern) ──────────────────
# Windows Git Bash may have a python3 alias that is the MS Store stub —
# it exits non-zero or opens the Store. Try python3 first, fall back to python,
# verify the result is actually Python 3.
_find_python() {
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      if "$candidate" --version 2>&1 | grep -q "^Python 3"; then
        echo "$candidate"; return 0
      fi
    fi
  done
  return 1
}

# ── deploy_tools (gendoc-style) ────────────────────────
# Walk $runtime/tools/<package>/, deploy each into $runtime/tools/bin/.
#   1. tools/<pkg>/build.sh exists → run it (BIN_DIR / PACKAGE_DIR injected)
#   2. else cp tools/<pkg>/<pkg>.py → tools/bin/<pkg>.py (single-file convention)
# Skips tools/bin itself.
_deploy_tools() {
  local runtime="$1"
  local bin_dir="$runtime/tools/bin"
  [[ -d "$runtime/tools" ]] || return 0
  mkdir -p "$bin_dir"
  log "[deploy] tools/<pkg>/ → $bin_dir"
  for pkg_dir in "$runtime/tools"/*/; do
    [[ -d "$pkg_dir" ]] || continue
    local pkg_name; pkg_name="$(basename "$pkg_dir")"
    [[ "$pkg_name" == "bin" ]] && continue
    if [[ -f "$pkg_dir/build.sh" ]]; then
      log "  · build $pkg_name (build.sh)"
      local py; py="$(_find_python)" || { log "  ✗ Python 3 not found"; return 1; }
      ( cd "$pkg_dir" && BIN_DIR="$bin_dir" PACKAGE_DIR="$pkg_dir" PY="$py" bash build.sh ) || {
        log "  ✗ build.sh failed for $pkg_name"; return 1; }
    else
      local entry="$pkg_dir$pkg_name.py"
      if [[ -f "$entry" ]]; then
        cp -f "$entry" "$bin_dir/$pkg_name.py"
        log "  · $pkg_name/$pkg_name.py → bin/$pkg_name.py"
      fi
    fi
  done
}

# ── install ───────────────────────────────────────────
_install_one() {
  local host="$1"
  local runtime; runtime="$(_host_dir "$host")"
  local skills_dst; skills_dst="$(_host_skills_dir "$host")"

  command -v git >/dev/null 2>&1 || { echo "❌ git required"; exit 1; }

  if [[ -d "$runtime/.git" ]]; then
    log "[install:$host] $runtime 已存在，執行 upgrade..."
    _upgrade_one "$host"
    return
  fi

  log "[install:$host] git clone $REPO_URL → $runtime"
  mkdir -p "$(dirname "$runtime")"
  git clone "$REPO_URL" "$runtime"
  _deploy_skills "$runtime" "$skills_dst"
  _deploy_tools "$runtime"

  log ""
  log "[install:$host] 完成。重啟 $host 讓 skills 生效。"
  log "  · 升級：$runtime/setup upgrade"
  log "  · 解除安裝：$runtime/setup uninstall"
}

# ── upgrade ───────────────────────────────────────────
_upgrade_one() {
  local host="$1"
  local runtime; runtime="$(_host_dir "$host")"
  local skills_dst; skills_dst="$(_host_skills_dir "$host")"
  if [[ ! -d "$runtime/.git" ]]; then
    log "[upgrade:$host] 找不到 $runtime，請先執行 install。"
    return 1
  fi
  log "[upgrade:$host] git pull..."
  git -C "$runtime" pull --ff-only
  # Re-exec freshly-pulled setup so any newly-added functions take effect (gendoc pattern).
  exec "$runtime/setup" _post_upgrade "$host"
}

_post_upgrade() {
  local host="$1"
  local runtime; runtime="$(_host_dir "$host")"
  local skills_dst; skills_dst="$(_host_skills_dir "$host")"
  _deploy_skills "$runtime" "$skills_dst"
  _deploy_tools "$runtime"
  log "[upgrade:$host] 完成。"
}

# ── uninstall ─────────────────────────────────────────
_uninstall_one() {
  local host="$1"
  local runtime; runtime="$(_host_dir "$host")"
  local skills_dst; skills_dst="$(_host_skills_dir "$host")"
  log "[uninstall:$host] 移除 deployed skills..."
  if [[ -d "$runtime/skills" ]]; then
    for skill_dir in "$runtime/skills"/*/; do
      [[ -d "$skill_dir" ]] || continue
      name="$(basename "$skill_dir")"
      if [[ -d "$skills_dst/$name" ]]; then
        rm -rf "$skills_dst/$name"
        log "  · 刪除 $skills_dst/$name"
      fi
    done
  fi
  log "[uninstall:$host] 刪除 $runtime..."
  rm -rf "$runtime"
  log "[uninstall:$host] 完成。"
}

case "$CMD" in
  install)
    for h in $(_resolve_targets "$TARGET"); do _install_one "$h"; done
    ;;
  upgrade)
    for h in $(_resolve_targets "$TARGET"); do _upgrade_one "$h"; done
    ;;
  uninstall)
    for h in $(_resolve_targets "$TARGET"); do _uninstall_one "$h"; done
    ;;
  _post_upgrade)
    _post_upgrade "$TARGET"
    ;;
  claude|codex|gemini|all)
    # Convenience: ./setup claude  ≡  ./setup install claude
    for h in $(_resolve_targets "$CMD"); do _install_one "$h"; done
    ;;
  *)
    cat <<EOF
用法：./setup <command> [target]

Commands:
  install [target]    git clone + 部署 subskills（預設）
  upgrade [target]    git pull + 重新部署
  uninstall [target]  移除 deployed skills + runtime
  claude              快捷：install claude
  codex               快捷：install codex
  gemini              快捷：install gemini
  all                 快捷：install all

Targets:
  claude              安裝到 ~/.claude/skills/genecr
  codex               安裝到 ~/.codex/skills/genecr
  gemini              安裝到 ~/.gemini/skills/genecr
  all                 三個 host 都裝
  (省略)              依本 setup 腳本所在位置自動判斷
EOF
    exit 1
    ;;
esac
